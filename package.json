{
	"name": "receiver-bot",
	"version": "0.0.1",
	"description": "An example receiver bot written using @discordjs/voice",
	"scripts": {
		"start": "npm run build && node -r tsconfig-paths/register dist/bot",
		"test": "npm run build && node --test test/*.test.cjs",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix",
		"prettier": "prettier --write .",
		"build": "npx tsc",
		"build:check": "npx tsc --noEmit --incremental false",
		"heroku-postbuild": "npm run build"
	},
	"author": "Amish Shah <contact@shah.gg>",
	"license": "MIT",
	"dependencies": {
		"@deepgram/sdk": "^3.9.0",
		"@discordjs/opus": "^0.9.0",
		"@discordjs/voice": "^0.19.0",
		"@snazzah/davey": "^0.1.10",
		"axios": "^1.8.1",
		"discord-api-types": "^0.37.61",
		"discord.js": "^14.25.1",
		"ffmpeg-static": "^5.2.0",
		"libsodium-wrappers": "^0.7.13",
		"node-crc": "^1.3.2",
		"openai": "^7.47.0",
		"prism-media": "^1.3.5",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.3.3",
		"websocket-stream": "^5.5.2"
	},
	"devDependencies": {
		"@types/node": "^20.10.5"
	},
	"engines": {
		"node": "22.x"
	}
}
